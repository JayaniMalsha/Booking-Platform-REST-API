# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_access_token_key_change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (sqlite or postgres)
DB_TYPE=sqlite

# SQLite Configuration (Used if DB_TYPE is sqlite)
DB_DATABASE=booking_db.sqlite

# PostgreSQL Configuration (Used if DB_TYPE is postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_123
DB_NAME=booking_platform
